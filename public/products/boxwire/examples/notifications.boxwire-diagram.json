{
  "format": "boxwire-diagram",
  "version": 1,
  "name": "Notification service",
  "direction": "LR",
  "nodes": [
    { "id": "req", "kind": "note", "label": "Requirements\n- push, email, SMS, in-app inbox\n- respect prefs + quiet hours\n- no duplicates (idempotency)\n- retries; at-least-once\n- 1B sends/day: 35k/s at 3×\n- ~1.3 channels per send\n- inbox: 100M DAU × 10 reads\n- keep 90 days of history" },
    { "id": "senders", "kind": "web-client", "icon": "server", "label": "Product services\n(order, social, …)", "capacity": { "writesPerDay": 1000000000, "readQps": 0, "peak": 3, "writeKB": 0.5, "readKB": 0.5 } },
    { "id": "igw", "kind": "api-gateway", "label": "Internal gateway (mTLS)", "capacity": { "replicas": 3, "qpsPerNode": 20000, "auth": true } },
    { "id": "notify", "kind": "service", "label": "Notification service\n(validate, dedupe, prefs)", "capacity": { "replicas": 12, "qpsPerNode": 5000 } },
    { "id": "prefcache", "kind": "cache", "label": "Redis: prefs + dedupe\n(idempotency keys)", "capacity": { "replicas": 2, "shards": 4, "qpsPerNode": 100000, "hitRatio": 0.95, "ttlSec": 300 } },
    { "id": "prefs", "kind": "sql-database", "label": "Preferences (Postgres)", "capacity": { "replicas": 3, "shards": 4, "qpsPerNode": 5000 } },
    { "id": "log", "kind": "nosql-store", "label": "Notification log\n(Cassandra, by user)", "capacity": { "replicas": 3, "shards": 64, "qpsPerNode": 10000, "retentionYears": 0.25, "replicationFactor": 3, "storageTB": 1000 } },
    { "id": "topic", "kind": "event-stream", "label": "Kafka: per-channel topics", "capacity": { "replicas": 3, "shards": 24, "qpsPerNode": 10000 } },
    { "id": "sched", "kind": "scheduler", "label": "Scheduler (send-at,\ncampaigns)", "capacity": { "replicas": 2 } },
    { "id": "dispatch", "kind": "worker", "label": "Channel workers\n(per-provider limits)", "capacity": { "replicas": 30, "qpsPerNode": 2000, "fanout": 1.3 } },
    { "id": "retry", "kind": "message-queue", "label": "Retry queue (SQS)\nbackoff + DLQ", "capacity": { "managed": true } },
    { "id": "apns", "kind": "notifications", "label": "APNs / FCM" },
    { "id": "email", "kind": "email-sms", "label": "Email (SES)" },
    { "id": "sms", "kind": "email-sms", "label": "SMS (Twilio)", "icon": "message" },
    { "id": "mobile", "kind": "mobile-app", "label": "Mobile app (inbox)", "capacity": { "dau": 100000000, "writesPerUser": 1, "readsPerUser": 10, "peak": 2, "writeKB": 0.2, "readKB": 2 } },
    { "id": "pgw", "kind": "api-gateway", "label": "Public gateway (OAuth)", "capacity": { "replicas": 3, "qpsPerNode": 20000, "auth": true } },
    { "id": "inbox", "kind": "service", "label": "Inbox + prefs API", "capacity": { "replicas": 8, "qpsPerNode": 5000 } },
    { "id": "inline", "kind": "service", "label": "Send inline from callers", "crossed": true },
    { "id": "trade", "kind": "note", "label": "Trade-offs\n- queue per channel: a slow SMS\n  provider can't block push\n- dedupe on idempotency key\n  before enqueue (SET NX)\n- at-least-once + retries; DLQ\n  after 5 tries\n- prefs cached 5 min: opt-out\n  is invalidated immediately" }
  ],
  "edges": [
    { "from": "senders", "to": "igw", "label": "POST /send" },
    { "from": "igw", "to": "notify" },
    { "from": "notify", "to": "prefcache" },
    { "from": "notify", "to": "prefs", "carries": "lookups" },
    { "from": "notify", "to": "log", "carries": "writes" },
    { "from": "notify", "to": "topic", "kind": "async", "carries": "writes" },
    { "from": "sched", "to": "topic", "kind": "async" },
    { "from": "topic", "to": "dispatch" },
    { "from": "dispatch", "to": "apns" },
    { "from": "dispatch", "to": "email" },
    { "from": "dispatch", "to": "sms" },
    { "from": "dispatch", "to": "retry", "kind": "async", "share": 0.05 },
    { "from": "retry", "to": "dispatch", "kind": "async" },
    { "from": "dispatch", "to": "log", "label": "status", "carries": "writes" },
    { "from": "mobile", "to": "pgw" },
    { "from": "pgw", "to": "inbox" },
    { "from": "inbox", "to": "log" },
    { "from": "inbox", "to": "prefs", "carries": "writes" },
    { "from": "inbox", "to": "prefcache", "label": "invalidate", "carries": "writes" }
  ],
  "frames": [
    { "id": "f-in", "label": "1 · Three ways in: API, scheduler, app", "contains": ["senders", "igw", "notify", "sched", "mobile", "pgw", "inbox"], "padding": 48 },
    { "id": "f-prefs", "label": "2 · + Preferences, dedupe and the topic", "contains": ["senders", "igw", "notify", "prefcache", "prefs", "topic", "sched", "mobile", "pgw", "inbox"] },
    { "id": "f-deliver", "label": "3 · + Deliver per channel, with retries", "contains": ["senders", "igw", "notify", "prefcache", "prefs", "log", "topic", "sched", "dispatch", "retry", "apns", "email", "sms", "mobile", "pgw", "inbox"] },
    { "id": "f-all", "label": "4 · Whole design", "contains": ["req", "senders", "igw", "notify", "prefcache", "prefs", "log", "topic", "sched", "dispatch", "retry", "apns", "email", "sms", "mobile", "pgw", "inbox", "inline", "trade"] }
  ]
}
